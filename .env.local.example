# Form submissions are emailed via Resend (https://resend.com).
# Sign up for free, grab an API key from the dashboard, and paste it below.
RESEND_API_KEY=

# Optional — defaults are fine for getting started:
#   RESEND_FROM defaults to "Midcoast Food <onboarding@resend.dev>"
#     (Resend's onboarding sender only delivers to the email used to register
#     the Resend account — fine for testing. To send from forms@midcoastfood.me
#     instead, verify the midcoastfood.me domain in Resend's DNS settings.)
#   RESEND_TO defaults to ren@sunshinehouse.xyz
#
# RESEND_FROM="Midcoast Food <forms@midcoastfood.me>"
# RESEND_TO=ren@sunshinehouse.xyz
